<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= h(title) %></title>
<style>
<%= stylesheet %>
</style>
<%= int("<style>\n#{internal_stylesheet}</style>") %>
</head>
<body>
<%= int(partial("banner")) %>
<%= partial("cover") -%>
<section class="contents-sec">
 <div class="wrap"><nav aria-label="Contents">
  <h2 class="h3" style="margin-bottom:0.5rem">Contents</h2>
  <ul class="toc desk"><%= toc_items %></ul>
  <details class="toc-mobile"><summary>On this page</summary><ul class="toc"><%= toc_items %></ul></details>
 </nav></div></section>
<main>
<%= partial("overview") -%>
<%= partial("findings") -%>
<%= partial("screenshots") if client_shots.any? -%>
<%= partial("how") -%>
<%= appendix_html %>
</main>
<footer class="doc-footer"><div class="wrap">
 <p class="brandrow"><span>Prepared by <strong><%= h(brand.name) %></strong></span></p>
 <p>Contact: <a href="mailto:<%= h(brand.contact_email) %>"><%= h(brand.contact_email) %></a></p>
 <p><%= h(confidentiality) %></p>
 <%= int(%(<p class="stamp">#{h(stamp)}</p>)) %>
</div></footer>
<%= lightbox_html -%>
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><defs>
<%= partial("sprite") -%>
</defs></svg>
</body>
</html>
